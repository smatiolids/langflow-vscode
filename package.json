{
  "name": "langflow-vscode",
  "displayName": "Langflow VS Code",
  "description": "Browse Langflow projects/flows and edit component code",
  "version": "0.0.1",
  "publisher": "smatioli",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/smatiolids/langflow-vscode"
  },
  "icon": "./resources/langflow-vscode_2.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:langflow.connect",
    "onCommand:langflow.setApiKey",
    "onCommand:langflow.refresh",
    "onView:langflowExplorer",
    "onView:langflowConnection",
    "onView:langflowProperties",
    "onView:langflowRunFlow"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "langflow.connect",
        "title": "Langflow: Connect"
      },
      {
        "command": "langflow.setApiKey",
        "title": "Langflow: Set API Key"
      },
      {
        "command": "langflow.refresh",
        "title": "Langflow: Refresh"
      },
      {
        "command": "langflow.openComponent",
        "title": "Langflow: Open Component"
      },
      {
        "command": "langflow.selectFlow",
        "title": "Langflow: Select Flow"
      },
      {
        "command": "langflow.selectComponent",
        "title": "Langflow: Select Component"
      },
      {
        "command": "langflow.openFlow",
        "title": "Langflow: Open Flow JSON"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "langflow.refresh",
          "when": "view == langflowExplorer",
          "group": "navigation"
        },
        {
          "command": "langflow.openComponent",
          "when": "view == langflowExplorer && viewItem == langflowComponent",
          "group": "navigation"
        },
        {
          "command": "langflow.openFlow",
          "when": "view == langflowExplorer && viewItem == langflowFlow",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "langflow",
          "title": "Langflow",
          "icon": "resources/langflow.svg"
        }
      ]
    },
    "views": {
      "langflow": [
        {
          "id": "langflowConnection",
          "name": "Connection",
          "type": "webview"
        },
        {
          "id": "langflowExplorer",
          "name": "Projects & Flows"
        },
        {
          "id": "langflowProperties",
          "name": "Properties",
          "type": "webview"
        },
        {
          "id": "langflowRunFlow",
          "name": "Run Flow",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "Langflow",
      "properties": {
        "langflow.baseUrl": {
          "type": "string",
          "default": "http://localhost:3000",
          "description": "Base URL for the Langflow instance"
        },
        "langflow.venvPath": {
          "type": "string",
          "default": "",
          "description": "Path to the Langflow Python virtual environment"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^18.18.13",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.2.2"
  }
}
